# Slack Bot Token (xoxb-...) — from OAuth & Permissions page after installing to workspace
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Slack App-Level Token (xapp-...) — from Basic Information > App-Level Tokens (with connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel to monitor — exact name without #, or use channel ID (e.g. C012AB3CD)
SLACK_MONITOR_CHANNEL=june-gear-swap

# Channel to post alerts into — can be the same channel or a different one
SLACK_ALERT_CHANNEL=june-gear-swap

# Comma-separated keywords to watch for (case-insensitive)
# Example: KEYWORDS=WTB,ISO,trade,swap,sold
KEYWORDS=

# Optional: bot will only alert, not reply in-thread, if set to "true"
ALERT_ONLY=false
