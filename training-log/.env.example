# Postgres connection string. Leave this unset locally and the app stores
# everything in .data/training-log.json instead, so `npm run dev` needs no setup.
#
# Neon / Vercel Postgres / Supabase / Railway all give you a URL in this shape:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: where the local JSON backend writes (defaults to ./.data)
# DATA_DIR=".data"
